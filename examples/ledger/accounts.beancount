;; =====================================================================
;; accounts.beancount — Chart of Accounts template (ledgermind)
;; Include this from your main ledger:  include "accounts.beancount"
;;
;; Naming convention:  Type:Category:Institution:Detail
;; Replace institution names / last-4 digits with your own.
;; Delete what you don't need; the agent only writes to accounts opened here.
;; =====================================================================


;; ---------------------------------------------------------------------
;; ASSETS
;; ---------------------------------------------------------------------

;; --- Cash & bank ---
2020-01-01 open Assets:Bank:Chase:Checking            USD
2020-01-01 open Assets:Bank:Chase:Savings             USD
2020-01-01 open Assets:Bank:Ally:HighYieldSavings     USD
2020-01-01 open Assets:Cash:Wallet                    USD

;; --- Payment apps (treated as cash accounts) ---
2020-01-01 open Assets:PaymentApps:Venmo              USD
2020-01-01 open Assets:PaymentApps:PayPal             USD
2020-01-01 open Assets:PaymentApps:Zelle              USD   ; clearing account

;; --- Brokerage: E*TRADE (taxable) ---
;; Cash sweep and positions are separate so lots are tracked cleanly.
2020-01-01 open Assets:Brokerage:Etrade:Cash          USD
2020-01-01 open Assets:Brokerage:Etrade:Stocks        "FIFO"   ; lots held at cost {}
2020-01-01 open Assets:Brokerage:Etrade:Options       "FIFO"   ; long option positions
;; Other brokers follow the same pattern:
;; 2020-01-01 open Assets:Brokerage:Schwab:Cash       USD
;; 2020-01-01 open Assets:Brokerage:Schwab:Stocks     "FIFO"

;; --- Retirement (tax-advantaged) ---
2020-01-01 open Assets:Retirement:Fidelity:401k       "FIFO"
2020-01-01 open Assets:Retirement:Fidelity:RothIRA    "FIFO"
2020-01-01 open Assets:Retirement:Fidelity:TradIRA    "FIFO"
2020-01-01 open Assets:Retirement:HSA                 "FIFO"

;; --- Real estate & vehicles (optional: for net worth) ---
2020-01-01 open Assets:RealEstate:Home                USD   ; purchase cost + improvements
2020-01-01 open Assets:Vehicles:Car                   USD   ; purchase cost

;; --- Escrow held by mortgage servicer ---
2020-01-01 open Assets:Escrow:PropertyTax             USD
2020-01-01 open Assets:Escrow:HomeInsurance           USD

;; --- Receivables & clearing ---
2020-01-01 open Assets:Receivables:Reimbursements     USD   ; money owed to you
2020-01-01 open Assets:Receivables:TaxRefund          USD
2020-01-01 open Assets:Transfers:InTransit            USD   ; agent uses this to match transfers between accounts

;; --- India (optional, NRI) ---
;; 2020-01-01 open Assets:India:Bank:NRE              INR
;; 2020-01-01 open Assets:India:Bank:NRO              INR
;; 2020-01-01 open Assets:India:Investments:MutualFunds "FIFO"

;; ---------------------------------------------------------------------
;; LIABILITIES
;; ---------------------------------------------------------------------

;; --- Credit cards ---
2020-01-01 open Liabilities:CreditCard:Amex:Platinum  USD
2020-01-01 open Liabilities:CreditCard:Chase:Sapphire USD
2020-01-01 open Liabilities:CreditCard:Citi:DoubleCash USD

;; --- Loans ---
2020-01-01 open Liabilities:Loans:Mortgage:Home       USD
2020-01-01 open Liabilities:Loans:Auto:Car            USD
;; 2020-01-01 open Liabilities:Loans:HELOC            USD

;; --- Brokerage liabilities ---
2020-01-01 open Liabilities:Brokerage:Etrade:Margin   USD
2020-01-01 open Liabilities:Brokerage:Etrade:ShortOptions "FIFO"  ; written (sold) options

;; --- Taxes payable ---
2020-01-01 open Liabilities:Taxes:Federal             USD
2020-01-01 open Liabilities:Taxes:California          USD

;; ---------------------------------------------------------------------
;; EQUITY
;; ---------------------------------------------------------------------
2020-01-01 open Equity:OpeningBalances
2020-01-01 open Equity:Conversions                    ; currency conversions (USD/INR)
2020-01-01 open Equity:Adjustments                    ; reconciliation write-offs (should stay tiny)

;; ---------------------------------------------------------------------
;; INCOME
;; ---------------------------------------------------------------------

;; --- Investment income ---
2020-01-01 open Income:Investments:CapitalGains            USD  ; importer default; split ST/LT at tax time
2020-01-01 open Income:Investments:CapitalGains:ShortTerm  USD
2020-01-01 open Income:Investments:CapitalGains:LongTerm   USD
2020-01-01 open Income:Investments:Options:ShortTerm       USD  ; premiums realized on close/expiry
2020-01-01 open Income:Investments:Dividends:Qualified     USD
2020-01-01 open Income:Investments:Dividends:Ordinary      USD
2020-01-01 open Income:Investments:Interest:Brokerage      USD
2020-01-01 open Income:Investments:Interest:Bank           USD
2020-01-01 open Income:Investments:WashSaleDisallowed      USD  ; memo: loss deferred into basis

;; --- Other income ---
2020-01-01 open Income:Salary                         USD
2020-01-01 open Income:Business:Consulting            USD
2020-01-01 open Income:Rewards:CreditCardCashback     USD
2020-01-01 open Income:Gifts                          USD
2020-01-01 open Income:Other                          USD

